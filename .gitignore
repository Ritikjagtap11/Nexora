# ════════════════════════════════════════════════════════════════════════════════
# NEXORA — .gitignore
# AI-Powered Intelligent Document Retrieval System
# Stack: React 19 (Vite) + FastAPI (Python) + Firebase + Google Drive + Cloudinary
# ════════════════════════════════════════════════════════════════════════════════

# ── Dependencies ─────────────────────────────────────────────────────────────
# Node.js packages (frontend) — reinstall with `npm install`
node_modules/

# Python virtual environment (backend) — recreate with `python -m venv venv`
venv/
.venv/
env/
ENV/

# ── Build Outputs ────────────────────────────────────────────────────────────
# Vite production build output
dist/
dist-ssr/

# Vite PWA service worker dev build
dev-dist/

# Python bytecode cache (auto-regenerated on run)
__pycache__/
*.py[cod]
*$py.class
*.pyo

# ── Environment & Secrets ────────────────────────────────────────────────────
# Environment variables with real secrets — NEVER commit these
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# NOTE: .env.example SHOULD be committed (contains only placeholders)
!.env.example

# Firebase & Google Cloud service account credentials
firebase-service-account.json
google-service-account.json
*-service-account.json
nexora-project-*.json

# Cryptographic keys and certificates
*.pem
*.key
*.cert
*.p12
*.pfx
secrets/
credentials.json

# ── IDE & Editor Files ───────────────────────────────────────────────────────
# VS Code (keep extensions.json if sharing recommended extensions with team)
.vscode/*
!.vscode/extensions.json

# JetBrains IDEs (PyCharm, WebStorm, IntelliJ)
.idea/

# Visual Studio
*.suo
*.ntvs*
*.njsproj
*.sln

# Vim/Neovim swap files
*.sw?
*.swo
*~

# ── OS-Generated Files ───────────────────────────────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
desktop.ini

# Linux
.directory

# ── Logs & Debug ─────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# ── Testing & Coverage ──────────────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov
.jest-cache/
.pytest_cache/
htmlcov/
.tox/

# ── Runtime Data (generated by app, not source code) ─────────────────────────
# Uploaded documents (user data, regenerated per session)
backend/uploads/*
!backend/uploads/.gitkeep

# FAISS vector store indices (regenerated from documents)
backend/vectorstore/*
!backend/vectorstore/.gitkeep

# ── Misc / Tooling Cache ────────────────────────────────────────────────────
.cache/
.parcel-cache/
.turbo/
.vercel/
.netlify/
*.tsbuildinfo
.eslintcache
.stylelintcache
storybook-static/

# Hugging Face model cache (sentence-transformers downloads models here)
.huggingface/
