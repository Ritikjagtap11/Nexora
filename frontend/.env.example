# ════════════════════════════════════════════════════════════════════════════════
# NEXORA — Frontend Production Environment Variables Template
# ════════════════════════════════════════════════════════════════════════════════

# The base URL of the Nexora FastAPI backend (no trailing slash)
# Example: https://nexora-backend.onrender.com
VITE_API_URL=

# Firebase configuration (obtained from Firebase Console -> Project Settings)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# Google OAuth 2.0 Client ID (obtained from Google Cloud Console -> Credentials)
VITE_GOOGLE_CLIENT_ID=
