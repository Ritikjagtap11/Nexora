# ════════════════════════════════════════════════════════════════════════════════
# NEXORA — Backend Production Environment Variables Template
# ════════════════════════════════════════════════════════════════════════════════

# ── Gemini API Keys (Up to 5 keys, round-robin rotator) ────────────────────────
# Add your Google Gemini API keys here. Nexora dynamically balances calls and handles quotas.
GEMINI_API_KEY_1=your_gemini_key_1_here
GEMINI_API_KEY_2=your_gemini_key_2_here
GEMINI_API_KEY_3=your_gemini_key_3_here
GEMINI_API_KEY_4=your_gemini_key_4_here
GEMINI_API_KEY_5=your_gemini_key_5_here

# ── Firebase Setup ───────────────────────────────────────────────────────────
# ID of your Firebase Project (e.g., nexora-25e8a)
FIREBASE_PROJECT_ID=your_firebase_project_id_here
# Path to your downloaded Firebase service account key JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# ── Google OAuth Setup (For User My Drive Scanning) ──────────────────────────
# Client Credentials obtained from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# The exact Authorized Redirect URI registered in Google Console
# Example: https://nexora-backend.onrender.com/api/drive/oauth/callback (production)
# Example: http://localhost:8000/api/drive/oauth/callback (local dev)
GOOGLE_REDIRECT_URI=http://localhost:8000/api/drive/oauth/callback

# ── Application Hardening & CORS ──────────────────────────────────────────────
# The URL of your React frontend app (used for dynamic CORS allowance and OAuth callback redirects)
# Example: https://nexora.onrender.com
FRONTEND_URL=

# ── Cloudinary Media Configuration ────────────────────────────────────────────
# Obtained from the Cloudinary Management Console
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# ── Performance Settings (Optional Custom Overrides) ─────────────────────────
UPLOAD_DIR=uploads
VECTORSTORE_DIR=vectorstore
MAX_UPLOAD_SIZE=10485760
CHUNK_SIZE=1000
CHUNK_OVERLAP=200