# Gemini API Keys (round-robin rotation)
# Provide up to 5 keys. If you have fewer, you can leave the others blank or remove them.
GEMINI_API_KEY_1=your_gemini_key_1_here
GEMINI_API_KEY_2=your_gemini_key_2_here
GEMINI_API_KEY_3=your_gemini_key_3_here
GEMINI_API_KEY_4=your_gemini_key_4_here
GEMINI_API_KEY_5=your_gemini_key_5_here

# Backend Firebase Configuration
# Path to your downloaded service account key JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Application Settings
UPLOAD_DIR=uploads
VECTORSTORE_DIR=vectorstore
MAX_UPLOAD_SIZE=10485760
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Google Drive Configuration
# Path to your Google Cloud service account JSON
GOOGLE_SERVICE_ACCOUNT_PATH=your-google-service-account.json
GOOGLE_DRIVE_ROOT_FOLDER_ID=your_drive_folder_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
NEXORA_UPLOAD_FOLDER_ID=your_upload_folder_id_here
